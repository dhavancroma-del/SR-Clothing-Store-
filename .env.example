NODE_ENV=development
PORT=3000
DB_PATH=./data/sr-clothing.sqlite
# Allowed origin for the storefront. Set this to your actual HTTPS domain in production.
APP_ORIGIN=http://localhost:3000
# Generate a private 32-byte key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_MFA_ENCRYPTION_KEY=
# Optional comma-separated IPs/CIDRs. Leave empty to allow sign-in from any IP.
ADMIN_IP_ALLOWLIST=
# Set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
